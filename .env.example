# Na Vercel, conecte um banco PostgreSQL (por exemplo, Neon) e defina esta variável.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Notificações push do resumo diário (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@aion.finance

# Protege a rota chamada diariamente pelo Vercel Cron.
CRON_SECRET=
