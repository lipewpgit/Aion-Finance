# Na Vercel, conecte um banco PostgreSQL (por exemplo, Neon). O projeto aceita
# DATABASE_URL e também os nomes POSTGRES_URL usados por algumas integrações.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Web Push. Gere com `npx web-push generate-vapid-keys` e mantenha a chave
# privada apenas nas variáveis Secret da Vercel.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://aion-finance-amber.vercel.app

# Protege a rota chamada diariamente pelo Vercel Cron.
CRON_SECRET=
